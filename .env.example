# ============================================================
# UltraAgent — .env.example
# انسخ الملف ده واسمه .env وحط فيه قيمك الحقيقية
# ⚠️  لا ترفع ملف .env على GitHub أبداً
# ============================================================

# ── NVIDIA NIM ──────────────────────────────────────────────
# سجل على: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=nvapi-xxxx

# ── Supabase ─────────────────────────────────────────────────
# سجل على: https://supabase.com → New Project → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJxxx

# ── Redis / Upstash ──────────────────────────────────────────
# سجل على: https://upstash.com → Create Database → Redis
REDIS_URL=redis://xxxx.upstash.io:6379
REDIS_PASSWORD=xxxx

# ── Telegram ─────────────────────────────────────────────────
# كلم @BotFather على Telegram → /newbot → انسخ الـ token
# عشان تعرف CHAT_ID بتاعك: كلم @userinfobot
TELEGRAM_BOT_TOKEN=xxxx:xxxx
TELEGRAM_ADMIN_CHAT_ID=123456789

# ── Tavily (Web Search) ───────────────────────────────────────
# سجل على: https://tavily.com → API Keys
TAVILY_API_KEY=tvly-xxxx

# ── E2B (Code Sandbox) ────────────────────────────────────────
# سجل على: https://e2b.dev → Dashboard → API Keys
E2B_API_KEY=xxxx

# ── App Config ───────────────────────────────────────────────
MAX_DAILY_REQUESTS=500
ENVIRONMENT=production
LOG_LEVEL=INFO
